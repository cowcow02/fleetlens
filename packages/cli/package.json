{
  "name": "fleetlens",
  "version": "1.0.13",
  "description": "fleetlens — local-only dashboard and usage tracker for Claude Code sessions and agent fleets",
  "license": "MIT",
  "author": "cowcow02",
  "homepage": "https://cowcow02.github.io/fleetlens/",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini-cli",
    "dashboard",
    "agent",
    "multi-agent",
    "observability",
    "usage",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowcow02/fleetlens.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "fleetlens": "./dist/index.js"
  },
  "files": [
    "dist",
    "app",
    "menubar",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint"
  },
  "devDependencies": {
    "@claude-lens/entries": "workspace:*",
    "@claude-lens/parser": "workspace:*",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
